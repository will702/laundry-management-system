# Database - choose one:
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin registration (keep secret, used once to create first admin)
ADMIN_REGISTRATION_CODE=CHANGE_THIS_BEFORE_DEPLOY

# AI (Phase 4)
ANTHROPIC_API_KEY=

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,capacitor://localhost,https://localhost
